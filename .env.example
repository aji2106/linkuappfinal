# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-new-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Production: DEBUG=False and your exact PythonAnywhere hostname(s), without https://.
CSRF_TRUSTED_ORIGINS=
# Optional existing SQLite database; leave blank to use var/linkup.sqlite3.
DATABASE_NAME=
# Optional existing uploads directory; default is var/media.
# MEDIA_ROOT=/absolute/path/to/uploads
# Email uses the console until SMTP is configured. Never use real credentials in Git.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
# Optional: configure BOTH keys to enable server-verified reCAPTCHA on signup.
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
